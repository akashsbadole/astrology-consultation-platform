# Copy this to .env and fill in real values before running docker compose.
# .env is gitignored — never commit real secrets.

# --- Domains ---
# Both MUST be subdomains of the same parent domain — see Caddyfile for why.
# Point both A records at this VPS's IP before starting the stack.
DOMAIN=example.com
API_DOMAIN=api.example.com

# --- Database ---
POSTGRES_USER=astrology
POSTGRES_PASSWORD=change-me-to-something-long-and-random
POSTGRES_DB=astrology

# --- JWT secrets ---
# Generate real values with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Use TWO DIFFERENT values — never reuse the same secret for both.
JWT_ACCESS_SECRET=REPLACE_ME_a-cinDGXMWIAw9TDZX32Zbm1zGqXjKL9Ck7oXbPmY0QGruvtuJELhemiVG1O8DkL
JWT_REFRESH_SECRET=REPLACE_ME_Aim-6xW2IohBdLn73d7ypgeOoGhor9p4biRB5WwYJDjOS3XZpnXmdErDrqWdNnk_

# --- Google OAuth ---
# The WEB client ID (not Android/iOS) — see README.md for where to create this.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# --- Razorpay (wallet recharge, store checkout) ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- LiveKit (audio/video calling) ---
# Must match the LIVEKIT_KEYS value set for the livekit service below.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-real-32-plus-char-secret
LIVEKIT_WS_URL=wss://your-livekit-domain-or-ip:7880

# --- SMTP (password reset, email verification) ---
# Any provider works via plain SMTP — SES, Postmark, SendGrid's SMTP
# endpoint, or your own mail server.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true

# --- App URL (used to build links inside reset/verification emails) ---
APP_BASE_URL=https://example.com

# --- Backend sizing ---
# Rule of thumb: (2 x vCPU count) + 1. Start conservative on a small VPS.
BACKEND_WORKERS=2
